#!/bin/bash
set -e
set -o pipefail

help()
{
    echo
    echo "$0: enables egress proxy for a given app."
    echo "Note that this will not set up egress, but rather re-enable egress that has been disabled with disable-egress."
    echo "Syntax: $0 <APP>"
    echo "  <APP> must be a valid cf app in the current space with egress disabled."
    #echo "Options:"
    #echo "  --space <SPACE>: #TODO"
    echo
    echo "To disable egress for an app, use disable-egress."
    echo "This depends on DATAGOV_DIR and CG_DIR environment variables being set."
    exit 1
}

app="$1"
space="$2"

if [ -z "$app" ]; then
    echo "No app provided."
    help
elif [ -z "$space" ]; then
    echo "No space provided."
    help
else
    # cg-egress-proxy needs jq 🤷
    if ! command -v jq &> /dev/null; then
        apt-get install jq -y
    fi

    acl_dir="$DATAGOV_DIR/egress/acl"
    allow_candidates=(
        "$acl_dir/$app/$space.allow.acl"
        "$acl_dir/$app/allow.acl"
    )
    deny_candidates=(
        "$acl_dir/$app/$space.deny.acl"
        "$acl_dir/$app/deny.acl"
    )
    allow_file=""
    deny_file=""

    for index in "${!allow_candidates[@]}"; do
        candidate_allow="${allow_candidates[$index]}"
        candidate_deny="${deny_candidates[$index]}"

        if [ -f "$candidate_allow" ] || [ -f "$candidate_deny" ]; then
            if [ ! -f "$candidate_allow" ] || [ ! -f "$candidate_deny" ]; then
                echo "ACL policy must include both ${candidate_allow} and ${candidate_deny}." >&2
                exit 1
            fi
            allow_file="$candidate_allow"
            deny_file="$candidate_deny"
            break
        fi
    done

    if [ -z "$allow_file" ]; then
        echo "No ACL policy found for $app in $space." >&2
        exit 1
    fi

    echo "Using ${allow_file#"$DATAGOV_DIR/"} and ${deny_file#"$DATAGOV_DIR/"}"
    cp "$allow_file" "$CG_DIR/${app}.allow.acl"
    cp "$deny_file" "$CG_DIR/${app}.deny.acl"

    # need to be in CG_DIR for cg-egress-proxy scripts to run correctly
    cd "$CG_DIR"
    bin/cf-deployproxy -a "$app" -s "$space-egress" -e "proxy_url"
fi
